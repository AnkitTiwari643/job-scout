# ============================================================
#  Job Scout — config
#  Copy this to .env and fill in your details.
# ============================================================

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Role keywords to match (comma-separated, case-insensitive) ---
ROLE_KEYWORDS=devops,dev ops,devsecops,sre,site reliability,platform engineer,infrastructure engineer,cloud engineer,kubernetes,docker,ci/cd,build engineer,release engineer,systems engineer

# --- Block these in job title ---
ROLE_BLOCKLIST=senior,sr.,sr ,lead,director,vp,head of,principal,staff,architect,manager,intern,trainee,fresher,junior,jr ,jr.,designer,sales,marketing,frontend,react,angular,data scientist,ml engineer,ai engineer

# --- Experience range (years) ---
MIN_EXPERIENCE=2
MAX_EXPERIENCE=5

# --- CTC range (LPA) ---
MIN_CTC=20
MAX_CTC=30

# --- Your skills (for matching score) ---
SKILLS=AWS,Kubernetes,Docker,Terraform,GitHub Actions,Jenkins,ECS,CloudFormation,Linux,Shell Scripting,Python,Datadog,PagerDuty,CI/CD,Ansible,Prometheus,Grafana,Helm,ArgoCD,GitOps

# --- Location preference ---
LOCATIONS=india,bangalore,bengaluru,remote,worldwide

# --- LinkedIn search keywords (each becomes a separate search) ---
SEARCH_KEYWORDS=devops engineer,sre engineer,site reliability engineer,platform engineer,cloud engineer,infrastructure engineer,kubernetes engineer,devops
